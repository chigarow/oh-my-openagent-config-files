{
  "hashline_edit": true,
  "new_task_system_enabled": true,
  "model_fallback": true,
  "disabled_skills": ["git-master"],
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 15000
  },
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": false
  },
  "sisyphus": {
    "tasks": {
      "storage_path": ".sisyphus/tasks",
      "claude_code_compat": false
    }
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      429,
      503,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 30,
    "timeout_seconds": 120,
    "notify_on_fallback": true
  },
  "categories": {
    "visual-engineering": {
      "model": "alibaba-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.4",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "artistry": {
      "model": "alibaba-coding-plan/kimi-k2.5",
      "fallback_models": [
        "openai/gpt-5.4",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "deep": {
      "model": "zai-coding-plan/glm-5.1",
      "fallback_models": [
        "openai/gpt-5.4",
        "alibaba-coding-plan/qwen3.6-plus"
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "unspecified-low": {
      "model": "alibaba-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        "zai-coding-plan/glm-5-turbo",
        "openai/gpt-5.4-mini"
      ]
    },
    "quick": {
      "model": "zai-coding-plan/glm-5-turbo",
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5",
        "openai/gpt-5.4-mini"
      ]
    },
    "writing": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5",
        "zai-coding-plan/glm-5.1"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback_models": [
        "alibaba-coding-plan/qwen3-max-2026-01-23",
        "zai-coding-plan/glm-5.1"
      ],
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "atlas": {
      "model": "alibaba-coding-plan/qwen3.6-plus",
      "fallback_models": [
        "openai/gpt-5.4",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus",
        "zai-coding-plan/glm-5.1"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.1",
        "alibaba-coding-plan/qwen3.6-plus"
      ]
    },
    "explore": {
      "model": "alibaba-coding-plan/MiniMax-M2.5",
      "fallback_models": [
        "zai-coding-plan/glm-5-turbo",
        "openai/gpt-5.4-mini"
      ]
    },
    "librarian": {
      "model": "zai-coding-plan/glm-5-turbo",
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5",
        "openai/gpt-5.4-mini"
      ]
    },
    "sisyphus-junior": {
      "model": "alibaba-coding-plan/kimi-k2.5",
      "fallback_models": [
        "zai-coding-plan/glm-5-turbo",
        "openai/gpt-5.4-mini"
      ]
    },
    "multimodal-looker": {
      "model": "zai-coding-plan/glm-5v-turbo",
      "fallback_models": [
        "openai/gpt-5.4",
        "alibaba-coding-plan/qwen3.6-plus"
      ]
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 180000,
    "circuitBreaker": {
      "enabled": true,
      "maxToolCalls": 200,
      "consecutiveThreshold": 10
    },
    "providerConcurrency": {
      "openai": 8,
      "alibaba-coding-plan": 7,
      "zai-coding-plan": 6
    },
    "modelConcurrency": {
      "openai/gpt-5.5": 3,
      "openai/gpt-5.4": 5,
      "openai/gpt-5.4-mini": 6,
      "openai/gpt-5.3-codex": 4,
      "alibaba-coding-plan/qwen3.6-plus": 5,
      "alibaba-coding-plan/kimi-k2.5": 5,
      "alibaba-coding-plan/qwen3-max-2026-01-23": 3,
      "alibaba-coding-plan/MiniMax-M2.5": 5,
      "zai-coding-plan/glm-5.1": 4,
      "zai-coding-plan/glm-5-turbo": 5,
      "zai-coding-plan/glm-5v-turbo": 3
    }
  },
  "experimental": {
    "task_system": true,
    "preemptive_compaction": true,
    "aggressive_truncation": true,
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "detailed",
      "turn_protection": {
        "enabled": true,
        "turns": 10
      },
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true,
          "aggressive": false
        },
        "purge_errors": {
          "enabled": true,
          "turns": 5
        }
      }
    }
  },
  "skills": {
    "sources": [
      {
        "path": "~/.config/opencode/skills",
        "recursive": true
      }
    ]
  },
  "disabled_hooks": [],
  "auto_update": true,
  "team_mode": {
    "enabled": true,
    "tmux_visualization": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "max_messages_per_run": 10000,
    "max_wall_clock_minutes": 120,
    "max_member_turns": 500
  }
}
