{
  "hashline_edit": true,
  "new_task_system_enabled": true,
  "model_fallback": true,
  "disabled_skills": ["git-master"],
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 15000
  },
  "sisyphus_agent": {
    "disabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "default_builder_enabled": false
  },
  "sisyphus": {
    "tasks": {
      "storage_path": ".sisyphus/tasks",
      "claude_code_compat": false
    }
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      429,
      503,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 30,
    "timeout_seconds": 120,
    "notify_on_fallback": true
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "variant": "medium",
      "description": "GPT-5.4 (medium) on OpenAI for visual tasks. Kimi K2.5 fallback."
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "variant": "high",
      "description": "GPT-5.5 (high) on OpenAI for deep reasoning. Qwen3.6 Plus fallback."
    },
    "deep": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "variant": "medium",
      "description": "GPT-5.4 (medium) on OpenAI for deep engineering. Qwen3.6 Plus fallback."
    },
    "artistry": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "variant": "medium",
      "description": "GPT-5.4 (medium) on OpenAI for creative tasks. Kimi K2.5 fallback."
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "variant": "medium",
      "description": "GPT-5.4 (medium) on OpenAI for complex work. Kimi K2.5 fallback."
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5"
      ],
      "variant": "low",
      "description": "GPT-5.4-mini (low) on OpenAI for moderate tasks. MiniMax M2.5 fallback."
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5"
      ],
      "variant": "low",
      "description": "GPT-5.4-mini (low) on OpenAI for trivial tasks. MiniMax M2.5 fallback."
    },
    "writing": {
      "model": "openai/gpt-5.4",
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "variant": "medium",
      "description": "GPT-5.4 (medium) on OpenAI for prose. Qwen3.6 Plus fallback."
    }
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "temperature": 0.1,
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "description": "The Boss. GPT-5.4 (high) on OpenAI. Kimi K2.5 fallback."
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "temperature": 0.05,
      "fallback_models": [
        "alibaba-coding-plan/qwen3-max-2026-01-23"
      ],
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      },
      "description": "The Worker. GPT-5.3-codex on OpenAI (medium). Qwen3 Max fallback. GPT-only agent."
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "temperature": 0.4,
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "description": "The Architect. GPT-5.5 (high) on OpenAI. Qwen3.6 Plus fallback."
    },
    "atlas": {
      "model": "alibaba-coding-plan/qwen3.6-plus",
      "temperature": 0.1,
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "description": "The Finisher. Qwen3.6 Plus on Alibaba primary. OpenAI GPT-5.4 fallback."
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "temperature": 0.25,
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "description": "The Debugger. GPT-5.5 (high) on OpenAI. Qwen3.6 Plus fallback."
    },
    "metis": {
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.4,
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "description": "Plan Consultant. GPT-5.4-mini on OpenAI (low). Kimi K2.5 fallback."
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "temperature": 0.2,
      "fallback_models": [
        "alibaba-coding-plan/qwen3.6-plus"
      ],
      "description": "Plan Reviewer. GPT-5.4 (high) on OpenAI. Qwen3.6 Plus fallback."
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.5,
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5"
      ],
      "description": "Utility Runner. GPT-5.4-mini on OpenAI (low). MiniMax M2.5 fallback."
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.3,
      "fallback_models": [
        "alibaba-coding-plan/MiniMax-M2.5"
      ],
      "description": "Research & Documentation. GPT-5.4-mini on OpenAI (low). GLM-5 fallback."
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4-mini",
      "temperature": 0.1,
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "description": "Task Delegate. GPT-5.4-mini on OpenAI (low). Kimi K2.5 fallback."
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "temperature": 0.1,
      "fallback_models": [
        "alibaba-coding-plan/kimi-k2.5"
      ],
      "description": "Vision tasks. GPT-5.4 on OpenAI (medium). Kimi K2.5 fallback."
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 180000,
    "circuitBreaker": {
      "enabled": true,
      "maxToolCalls": 200,
      "consecutiveThreshold": 10
    },
    "providerConcurrency": {
      "alibaba-coding-plan": 25,
      "openai": 20,
      "opencode": 10,
      "anthropic": 5
    },
    "modelConcurrency": {
      "openai/gpt-5.5": 4,
      "openai/gpt-5.3-codex": 2,
      "openai/gpt-5.4": 10,
      "openai/gpt-5.4-mini": 8,
      "alibaba-coding-plan/kimi-k2.5": 8,
      "alibaba-coding-plan/qwen3.6-plus": 6,
      "alibaba-coding-plan/qwen3-max-2026-01-23": 4,
      "alibaba-coding-plan/MiniMax-M2.5": 5
    }
  },
  "experimental": {
    "task_system": true,
    "preemptive_compaction": true,
    "aggressive_truncation": true,
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "detailed",
      "turn_protection": {
        "enabled": true,
        "turns": 10
      },
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true,
          "aggressive": false
        },
        "purge_errors": {
          "enabled": true,
          "turns": 5
        }
      }
    }
  },
  "skills": {
    "sources": [
      {
        "path": "~/.config/opencode/skills",
        "recursive": true
      }
    ]
  },
  "disabled_hooks": [],
  "auto_update": true,
  "team_mode": {
    "enabled": true,
    "tmux_visualization": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "max_messages_per_run": 10000,
    "max_wall_clock_minutes": 120,
    "max_member_turns": 500
  }
}
